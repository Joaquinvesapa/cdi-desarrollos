---
const navLinks = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Por Qué Nosotros', href: '#por-que-nosotros' },
  { label: 'Equipo', href: '#equipo' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer class="border-t border-cdi-border bg-cdi-bg py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Logo -->
      <a href="#" class="font-display font-extrabold text-lg text-cdi-text">
        CDI <span class="text-cdi-accent">Desarrollos</span>
      </a>

      <!-- Nav links -->
      <nav class="flex flex-wrap items-center justify-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-cdi-text-muted hover:text-cdi-accent transition-colors text-sm"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Social / domain -->
      <div class="text-cdi-text-muted text-sm">
        cdidesarrollos.com
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-cdi-border text-center">
      <p class="text-cdi-text-muted text-sm">
        &copy; {new Date().getFullYear()} CDI Desarrollos. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
