---
const year = new Date().getFullYear();
---

<footer class="border-t border-cdi-border bg-cdi-bg">
  <div class="px-[clamp(1rem,4vw,3rem)] py-8 flex flex-col sm:flex-row justify-between items-center gap-4">
    <!-- Logo -->
    <a href="#" class="font-display font-extrabold text-[0.8125rem] text-cdi-text-muted tracking-[-0.02em]">
      CDI <span class="text-cdi-accent">Desarrollos</span>
    </a>

    <!-- Copyright -->
    <span class="text-[0.8125rem] text-cdi-text-muted">
      &copy; {year} CDI Desarrollos
    </span>

    <!-- Domain -->
    <span class="text-[0.8125rem] text-cdi-text-muted">
      cdidesarrollos.com
    </span>
  </div>
</footer>
