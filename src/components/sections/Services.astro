---
const services = [
  {
    number: '01',
    title: 'Desarrollo Web a Medida',
    description: 'Sitios y aplicaciones web diseñadas desde cero para tus necesidades reales. Sin templates. Sin límites.',
  },
  {
    number: '02',
    title: 'Sistemas de Gestión',
    description: 'Software interno que automatiza procesos, reduce errores y te ahorra tiempo. Pensado para cómo trabaja tu empresa.',
  },
  {
    number: '03',
    title: 'Consultoría y Acompañamiento',
    description: 'Te ayudamos a entender qué necesitás tecnológicamente y te acompañamos en cada paso de la implementación.',
  },
];
---

<section id="servicios" class="editorial-section bg-cdi-bg">
  <div class="flex flex-col gap-[clamp(4rem,8vw,8rem)]">
    {services.map((service) => (
      <div
        class="border-t border-cdi-border pt-[clamp(2rem,4vw,4rem)] grid grid-cols-1 lg:grid-cols-2 gap-8"
        data-service-block
        data-reveal
      >
        <!-- Left column: number eyebrow + title -->
        <div>
          <span class="block text-[0.75rem] text-cdi-text-muted uppercase tracking-[0.15em] mb-4">
            {service.number}
          </span>
          <h3 class="type-section font-display font-bold leading-[1.1] text-cdi-text">
            {service.title}
          </h3>
        </div>

        <!-- Right column: description -->
        <div class="flex items-end">
          <p class="text-[clamp(1rem,1.5vw,1.125rem)] text-cdi-text-muted max-w-[42ch] leading-relaxed">
            {service.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
