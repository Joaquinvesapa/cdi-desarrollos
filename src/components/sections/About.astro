---
import SectionTitle from '../ui/SectionTitle.astro';

const team = [
  {
    initials: 'RV',
    name: 'Ricardo Ivan Guillermo Vesco',
    role: 'Analista de Sistemas',
    bio: 'Más de 20 años entendiendo los problemas reales de las empresas. Traduce las necesidades del negocio en soluciones concretas.',
  },
  {
    initials: 'JV',
    name: 'Joaquín Vesco Aparicio',
    role: 'Desarrollador Fullstack',
    bio: 'Especializado en arquitectura de software y experiencias web de alto rendimiento. Construye los sistemas que otros solo imaginan.',
  },
];
---

<section id="equipo" class="py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="animate-on-scroll">
      <SectionTitle eyebrow="Quiénes somos" title="Nuestro Equipo" />
    </div>

    <p class="text-cdi-text-muted text-lg text-center max-w-3xl mx-auto mb-16 leading-relaxed animate-on-scroll">
      CDI Desarrollos nació de una idea simple: que las empresas merecen tecnología pensada para ellas.
      Somos un equipo familiar de profesionales que combina experiencia en análisis de sistemas con
      desarrollo moderno para crear soluciones digitales que realmente funcionan.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      {team.map((member, i) => (
        <div
          class="animate-on-scroll rounded-2xl border border-cdi-border bg-cdi-surface/40 p-8 text-center"
          style={`animation-delay: ${i * 150}ms`}
        >
          <!-- Initials placeholder avatar -->
          <div class="mx-auto mb-5 flex h-24 w-24 items-center justify-center rounded-full bg-cdi-accent/10 border-2 border-cdi-accent/30">
            <span class="font-display font-extrabold text-2xl text-cdi-accent">{member.initials}</span>
          </div>

          <h3 class="font-display font-bold text-xl text-cdi-text mb-1">{member.name}</h3>
          <span class="text-cdi-accent font-semibold text-sm mb-4 block">{member.role}</span>
          <p class="text-cdi-text-muted text-sm leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>
