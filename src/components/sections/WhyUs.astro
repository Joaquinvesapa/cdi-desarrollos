---
const differentiators = [
  {
    number: '01',
    title: 'Trato Directo',
    description: 'Hablás directamente con quienes construyen tu producto. Sin intermediarios, sin burocracia.',
  },
  {
    number: '02',
    title: 'Soluciones Reales, No Genéricas',
    description: 'No vendemos templates. Cada línea de código está pensada para tu caso de uso.',
  },
  {
    number: '03',
    title: 'Tecnología de Primer Nivel',
    description: 'Usamos las mismas herramientas y prácticas que las mejores empresas de software del mundo.',
  },
  {
    number: '04',
    title: 'Compromiso de Principio a Fin',
    description: 'No desaparecemos después de entregar. Te acompañamos, capacitamos y mantenemos tu sistema.',
  },
];
---

<section id="por-que-nosotros" class="editorial-section bg-cdi-bg-alt">
  <div class="flex flex-col gap-0">
    {differentiators.map((item) => (
      <div
        class="border-t border-cdi-border py-[clamp(2rem,4vw,4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 lg:gap-12 items-start"
        data-reveal
      >
        <!-- Number decoration -->
        <div
          class="font-display font-extrabold text-cdi-gold opacity-30 leading-none select-none"
          style="font-size: clamp(3rem,6vw,6rem);"
          aria-hidden="true"
        >
          {item.number}
        </div>

        <!-- Content -->
        <div>
          <h3
            class="font-display font-bold leading-snug text-cdi-text"
            style="font-size: clamp(1.5rem,3.5vw,2.5rem);"
          >
            {item.title}
          </h3>
          <p class="text-cdi-text-muted mt-3 leading-relaxed text-[length:var(--font-size-subtitle)]">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
