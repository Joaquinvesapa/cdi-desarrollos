---
import SectionTitle from '../ui/SectionTitle.astro';

const differentiators = [
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>',
    title: 'Trato Directo',
    description: 'Hablás directamente con quienes construyen tu producto. Sin intermediarios, sin burocracia.',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" /></svg>',
    title: 'Soluciones Reales, No Genéricas',
    description: 'No vendemos templates. Cada línea de código está pensada para tu caso de uso.',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>',
    title: 'Tecnología de Primer Nivel',
    description: 'Usamos las mismas herramientas y prácticas que las mejores empresas de software del mundo.',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>',
    title: 'Compromiso de Principio a Fin',
    description: 'No desaparecemos después de entregar. Te acompañamos, capacitamos y mantenemos tu sistema.',
  },
];
---

<section id="por-que-nosotros" class="py-24 lg:py-32 bg-cdi-bg-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="animate-on-scroll">
      <SectionTitle eyebrow="Por qué elegirnos" title="Lo Que Nos Diferencia" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-10 max-w-4xl mx-auto">
      {differentiators.map((item, i) => (
        <div class="animate-on-scroll flex gap-5" style={`animation-delay: ${i * 120}ms`}>
          <div class="shrink-0 flex h-14 w-14 items-center justify-center rounded-2xl bg-cdi-accent/10 text-cdi-accent">
            <Fragment set:html={item.icon} />
          </div>
          <div>
            <h3 class="font-display font-bold text-lg mb-2 text-cdi-text">{item.title}</h3>
            <p class="text-cdi-text-muted leading-relaxed text-sm">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
