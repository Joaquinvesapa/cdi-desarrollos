---
---

<section id="contacto" class="editorial-section bg-cdi-bg-alt">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

    <!-- Left: typographic statement -->
    <div>
      <h2
        class="type-statement font-display font-extrabold leading-[0.9] tracking-[-0.03em] text-cdi-text"
        data-contact-title
      >
        Hablemos<span class="text-cdi-accent">.</span>
      </h2>
      <p class="text-[clamp(1rem,1.5vw,1.125rem)] text-cdi-text-muted max-w-[38ch] leading-relaxed mt-6" data-reveal>
        Contanos tu idea y te respondemos en menos de 24 horas.
      </p>
    </div>

    <!-- Right: contact form -->
    <div class="lg:pt-4" data-reveal>
      <!-- Form -->
      <form id="contact-form" novalidate>

        <!-- Honeypot: hidden from humans, filled by bots -->
        <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;pointer-events:none;" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-5">

          <!-- Nombre -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-nombre" class="text-sm font-medium text-cdi-text-muted tracking-wide uppercase">
              Nombre
            </label>
            <input
              type="text"
              id="contact-nombre"
              name="nombre"
              required
              autocomplete="name"
              placeholder="Tu nombre"
              class="bg-cdi-surface border border-cdi-border text-cdi-text placeholder:text-cdi-text-muted/50 rounded-md px-4 py-3 text-base outline-none focus:border-cdi-accent focus:ring-1 focus:ring-cdi-accent transition-colors duration-200"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-email" class="text-sm font-medium text-cdi-text-muted tracking-wide uppercase">
              Email
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
              class="bg-cdi-surface border border-cdi-border text-cdi-text placeholder:text-cdi-text-muted/50 rounded-md px-4 py-3 text-base outline-none focus:border-cdi-accent focus:ring-1 focus:ring-cdi-accent transition-colors duration-200"
            />
          </div>

          <!-- Asunto -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-asunto" class="text-sm font-medium text-cdi-text-muted tracking-wide uppercase">
              Asunto
            </label>
            <input
              type="text"
              id="contact-asunto"
              name="asunto"
              required
              placeholder="¿Sobre qué nos querés consultar?"
              class="bg-cdi-surface border border-cdi-border text-cdi-text placeholder:text-cdi-text-muted/50 rounded-md px-4 py-3 text-base outline-none focus:border-cdi-accent focus:ring-1 focus:ring-cdi-accent transition-colors duration-200"
            />
          </div>

          <!-- Mensaje -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-mensaje" class="text-sm font-medium text-cdi-text-muted tracking-wide uppercase">
              Mensaje
            </label>
            <textarea
              id="contact-mensaje"
              name="mensaje"
              required
              rows="5"
              placeholder="Contanos tu idea o proyecto..."
              class="bg-cdi-surface border border-cdi-border text-cdi-text placeholder:text-cdi-text-muted/50 rounded-md px-4 py-3 text-base outline-none focus:border-cdi-accent focus:ring-1 focus:ring-cdi-accent transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center justify-center gap-2 bg-cdi-accent hover:bg-cdi-accent-dark text-cdi-bg font-bold text-base px-6 py-3 rounded-md transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed self-start"
          >
            <span id="submit-label">Enviar mensaje</span>
            <svg
              id="submit-spinner"
              class="hidden w-4 h-4 animate-spin"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
          </button>

          <!-- Error message -->
          <p id="contact-error" class="hidden text-sm text-red-400 leading-relaxed" role="alert" aria-live="polite"></p>

        </div>
      </form>

      <!-- Success state (hidden until form sends) -->
      <div id="contact-success" class="hidden">
        <div class="flex items-start gap-4 bg-cdi-surface border border-cdi-border rounded-md px-6 py-5">
          <svg class="w-6 h-6 text-cdi-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="font-semibold text-cdi-text">¡Mensaje enviado!</p>
            <p class="text-cdi-text-muted text-sm mt-1">Te respondemos en menos de 24 horas.</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Fallback contact links -->
  <div class="mt-12 pt-8 border-t border-cdi-border flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal>
    <span class="text-cdi-text-muted text-sm">O escribinos directamente:</span>

    <!-- Email -->
    <a
      href="mailto:contacto@cdidesarrollos.com"
      class="flex items-center gap-2 text-cdi-text-muted hover:text-cdi-accent transition-colors duration-200 group text-sm"
    >
      <svg class="w-4 h-4 shrink-0 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
      </svg>
      <span>contacto@cdidesarrollos.com</span>
    </a>

    <!-- WhatsApp -->
    <a
      href="https://wa.me/5491100000000"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-cdi-text-muted hover:text-cdi-accent transition-colors duration-200 group text-sm"
    >
      <svg class="w-4 h-4 shrink-0 opacity-60 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
      <span>Escribinos por WhatsApp</span>
    </a>
  </div>

</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const submitSpinner = document.getElementById('submit-spinner');
  const errorEl = document.getElementById('contact-error');
  const successEl = document.getElementById('contact-success');

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous error
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }

      // Read fields
      const nombre = (form.elements.namedItem('nombre') as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const asunto = (form.elements.namedItem('asunto') as HTMLInputElement).value.trim();
      const mensaje = (form.elements.namedItem('mensaje') as HTMLTextAreaElement).value.trim();
      const website = (form.elements.namedItem('website') as HTMLInputElement).value;

      // Basic client-side validation
      if (!nombre || !email || !asunto || !mensaje) {
        showError('Por favor completá todos los campos.');
        return;
      }

      // Loading state
      setLoading(true);

      try {
        // Get reCAPTCHA v3 token
        const recaptchaToken = await (window as any).grecaptcha.execute(
          '6Lf_cZksAAAAALlJFbjlv52Tpw6548awLle2vW69',
          { action: 'contact' }
        );

        const res = await fetch('/mailer.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, email, asunto, mensaje, website, recaptcha_token: recaptchaToken }),
        });

        const json = await res.json();

        if (json.success) {
          // Show success, hide form
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
        } else {
          showError(json.message ?? 'Error al enviar. Intentá de nuevo.');
        }
      } catch {
        showError('No se pudo conectar. Revisá tu conexión e intentá de nuevo.');
      } finally {
        setLoading(false);
      }
    });
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel || !submitSpinner) return;
    submitBtn.disabled = loading;
    submitLabel.textContent = loading ? 'Enviando...' : 'Enviar mensaje';
    submitSpinner.classList.toggle('hidden', !loading);
  }

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }
</script>
