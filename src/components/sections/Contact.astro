---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="contacto" class="py-24 lg:py-32 bg-cdi-bg-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="animate-on-scroll">
      <SectionTitle eyebrow="Contacto" title="¿Listo para dar el siguiente paso?" />
    </div>

    <p class="text-cdi-text-muted text-lg text-center max-w-2xl mx-auto mb-12 animate-on-scroll">
      Contanos tu idea y te respondemos en menos de 24 horas.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Contact info -->
      <div class="animate-on-scroll flex flex-col gap-6">
        <a
          href="mailto:contacto@cdidesarrollos.com"
          class="flex items-center gap-4 rounded-xl border border-cdi-border bg-cdi-surface/40 p-5 transition-colors hover:border-cdi-accent/40"
        >
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cdi-accent/10 text-cdi-accent">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <span class="text-cdi-text font-semibold block">Email</span>
            <span class="text-cdi-text-muted text-sm">contacto@cdidesarrollos.com</span>
          </div>
        </a>

        <a
          href="https://wa.me/5491100000000"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-xl border border-cdi-border bg-cdi-surface/40 p-5 transition-colors hover:border-cdi-accent/40"
        >
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cdi-accent/10 text-cdi-accent">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
            </svg>
          </div>
          <div>
            <span class="text-cdi-text font-semibold block">WhatsApp</span>
            <span class="text-cdi-text-muted text-sm">Escribinos por WhatsApp</span>
          </div>
        </a>
      </div>

      <!-- Visual-only form placeholder (FR-07) -->
      <div class="animate-on-scroll rounded-2xl border border-cdi-border bg-cdi-surface/40 p-8" style="animation-delay: 150ms">
        <form class="flex flex-col gap-5" onsubmit="return false">
          <div>
            <label for="name" class="block text-sm font-medium text-cdi-text-muted mb-2">Nombre</label>
            <input
              id="name"
              type="text"
              placeholder="Tu nombre"
              class="w-full rounded-lg border border-cdi-border bg-cdi-bg px-4 py-3 text-cdi-text placeholder:text-cdi-text-muted/50 focus:outline-none focus:border-cdi-accent/50 transition-colors"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-cdi-text-muted mb-2">Email</label>
            <input
              id="email"
              type="email"
              placeholder="tu@email.com"
              class="w-full rounded-lg border border-cdi-border bg-cdi-bg px-4 py-3 text-cdi-text placeholder:text-cdi-text-muted/50 focus:outline-none focus:border-cdi-accent/50 transition-colors"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-cdi-text-muted mb-2">Mensaje</label>
            <textarea
              id="message"
              rows="4"
              placeholder="Contanos sobre tu proyecto..."
              class="w-full rounded-lg border border-cdi-border bg-cdi-bg px-4 py-3 text-cdi-text placeholder:text-cdi-text-muted/50 focus:outline-none focus:border-cdi-accent/50 transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="button"
            disabled
            class="w-full rounded-lg bg-cdi-accent/50 px-6 py-3 font-semibold text-cdi-bg cursor-not-allowed"
            title="Próximamente"
          >
            Próximamente
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
