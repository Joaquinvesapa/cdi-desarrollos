---
import Button from '../ui/Button.astro';
---

<section
  id="main-content"
  class="editorial-section w-full min-h-svh grid place-items-center overflow-hidden bg-cdi-bg"
>
  <div class="w-full">
    <h1
      class="type-hero font-display font-extrabold text-cdi-text"
      data-hero-title
    >
      Construimos software que<br />
      <span class="text-cdi-accent">impulsa tu negocio</span>
    </h1>

    <p
      class="text-[clamp(1.125rem,2vw,1.5rem)] leading-relaxed text-cdi-text-muted max-w-[36ch] mt-6"
      data-hero-subtitle
    >
      Soluciones digitales a medida para empresas que quieren crecer.
      Diseño, desarrollo y acompañamiento real.
    </p>

    <div
      class="flex flex-col sm:flex-row items-center sm:items-start gap-4 mt-10"
      data-hero-ctas
    >
      <Button variant="primary" href="#contacto" label="Hablemos" />
      <Button variant="ghost" href="#servicios" label="Conocé nuestros servicios" />
    </div>
  </div>
</section>
