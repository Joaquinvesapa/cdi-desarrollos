---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div
  class="sticky top-8 z-10 origin-top-left mb-12"
  data-sticky-scale
>
  {eyebrow && (
    <span class="text-[0.75rem] text-cdi-accent font-body font-semibold uppercase tracking-[0.15em] mb-3 block">
      {eyebrow}
    </span>
  )}
  <h2 class="type-section font-display font-bold text-cdi-text">
    {title}
  </h2>
</div>
